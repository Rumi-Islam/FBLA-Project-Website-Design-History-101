generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id               Int        @id @default(autoincrement())
  username         String     @unique
  email            String     @unique
  password         String
  createdAt        DateTime   @default(now())
  
  // This tells Prisma a User can have multiple Activity records
  history          Activity[]
  uploads   Upload[]
}

model Activity {
  id        Int      @id @default(autoincrement())
  title     String   // e.g., "Unit 1: The Silk Roads"
  link      String   // e.g., "/resources/unit1"
  createdAt DateTime @default(now())

  // This links the activity back to the specific User
  user      User     @relation(fields: [userId], references: [id])
  userId    Int
}

// add this to your schema.prisma
model Upload {
  id        Int      @id @default(autoincrement())
  fileName  String
  fileUrl   String
  fileType  String   // e.g., "pdf", "video", "image"
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
  userId    Int
}