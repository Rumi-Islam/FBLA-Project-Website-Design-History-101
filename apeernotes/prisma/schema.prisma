generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id               Int      @id @default(autoincrement())
  username         String   @unique
  email            String   @unique
  password         String
  createdAt        DateTime @default(now())
  
  // Add these two lines:
  lastUnitAccessed String?  // The "?" means it starts as empty (null)
  lastUnitLink     String?  // This stores the URL to the unit
}